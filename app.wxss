page {
  background: #f7f9fb;
  color: #191c1e;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx 24rpx 40rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 18rpx;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.topbar-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #003053;
}

.topbar-title {
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 700;
  color: #003053;
}

.topbar-action {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #727780;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(25, 28, 30, 0.04);
  font-size: 26rpx;
}

.hero-card,
.panel,
.spot-card,
.timeline-item,
.service-card,
.member-card,
.list-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
}

.section {
  margin-top: 34rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 36rpx;
  font-weight: 800;
  color: #003053;
  letter-spacing: -0.5rpx;
}

.section-subtitle {
  margin-top: 6rpx;
  color: #727780;
  font-size: 22rpx;
  line-height: 1.5;
}

.ghost-arrow {
  color: #727780;
  font-size: 28rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #727780;
  background: #f2f4f6;
}

.score {
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
}

.button-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 84rpx;
  border-radius: 24rpx;
  background: #006970;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.button-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 24rpx;
  border-radius: 22rpx;
  background: #f2f4f6;
  color: #003053;
  font-size: 24rpx;
  font-weight: 700;
}
