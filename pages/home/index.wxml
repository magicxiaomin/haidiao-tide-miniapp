<view class="container">
  <view class="topbar">
    <view class="topbar-left">
      <view class="topbar-dot"></view>
      <view class="topbar-title">{{location}}</view>
    </view>
    <view class="topbar-action">Go</view>
  </view>

  <view class="hero-card home-hero">
    <view class="hero-head">
      <view class="hero-copy">
        <view class="hero-title">今日海钓指数</view>
        <view class="hero-caption">{{summary.title}}</view>
        <view class="hero-sub">{{liveBadge}}</view>
      </view>
      <view class="gauge">
        <view class="gauge-ring"></view>
        <view class="gauge-value">{{summary.score}}</view>
      </view>
    </view>

    <view class="hero-window">
      <view class="hero-window-label">最佳时间窗口</view>
      <view class="hero-window-value">{{summary.bestWindow}}</view>
    </view>

    <view class="hero-weather">{{summary.weather}}</view>
    <view class="hero-warning">{{summary.risk}}</view>

    <view class="hero-actions">
      <view class="button-primary" bindtap="goPlanner">安排出钓计划</view>
    </view>
    <view class="hero-glow"></view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">关键潮时</view>
      </view>
      <view class="ghost-arrow">More</view>
    </view>
    <scroll-view scroll-x class="tide-scroll" enhanced="true" show-scrollbar="false">
      <view class="tide-row">
        <block wx:for="{{trend}}" wx:key="time">
          <view class="tide-card {{index === 1 ? 'active' : ''}}">
            <view class="tide-icon">{{index === 0 ? 'R' : index === 1 ? 'H' : index === 2 ? 'F' : 'L'}}</view>
            <view class="tide-state">{{item.state}}</view>
            <view class="tide-time">{{item.time}}</view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">热门钓点</view>
      </view>
    </view>
    <view class="spot-list">
      <block wx:for="{{spots}}" wx:key="id">
        <view class="spot-item" bindtap="goSpotDetail" data-id="{{item.id}}">
          <view class="spot-thumb spot-thumb-{{index}}"></view>
          <view class="spot-main">
            <view class="spot-top">
              <view class="spot-name">{{item.name}}</view>
              <view class="risk-pill {{item.riskLevel}}">{{item.riskText}}</view>
            </view>
            <view class="spot-meta">{{item.tags[0]}} · {{item.distanceKm}}km</view>
            <view class="spot-best">Best {{item.bestWindow}}</view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
