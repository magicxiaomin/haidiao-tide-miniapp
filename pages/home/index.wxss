.home-hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #003053 0%, #004777 100%);
  color: #ffffff;
}

.hero-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.hero-copy {
  flex: 1;
}

.hero-title {
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
}

.hero-caption {
  margin-top: 12rpx;
  max-width: 360rpx;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.hero-sub {
  margin-top: 12rpx;
  max-width: 360rpx;
  color: rgba(132, 182, 236, 0.96);
  font-size: 22rpx;
  line-height: 1.5;
}

.gauge {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
}

.gauge-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 10rpx solid rgba(255, 255, 255, 0.12);
  border-top-color: #006970;
  border-right-color: #006970;
  transform: rotate(22deg);
}

.gauge-value {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-window {
  position: relative;
  z-index: 2;
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero-window-label {
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}

.hero-window-value {
  margin-top: 10rpx;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 34rpx;
  font-weight: 800;
}

.hero-weather {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.84);
}

.hero-warning {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #d0e4ff;
}

.hero-actions {
  position: relative;
  z-index: 2;
  margin-top: 26rpx;
}

.hero-glow {
  position: absolute;
  right: -40rpx;
  bottom: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(150, 241, 250, 0.16);
  filter: blur(40rpx);
}

.tide-scroll {
  margin: 0 -24rpx;
  padding: 0 24rpx 8rpx;
  white-space: nowrap;
}

.tide-row {
  display: inline-flex;
  gap: 18rpx;
}

.tide-card {
  min-width: 180rpx;
  padding: 28rpx 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(25, 28, 30, 0.04);
}

.tide-card.active {
  background: rgba(150, 241, 250, 0.28);
}

.tide-icon {
  color: #006970;
  font-size: 28rpx;
}

.tide-state {
  margin-top: 18rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #727780;
  letter-spacing: 1.5rpx;
}

.tide-time {
  margin-top: 10rpx;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 42rpx;
  font-weight: 800;
  color: #003053;
}

.spot-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.spot-item {
  display: flex;
  gap: 20rpx;
  padding: 18rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(25, 28, 30, 0.04);
}

.spot-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #9ccaff 0%, #2c6193 52%, #003053 100%);
}

.spot-thumb-0 {
  background: linear-gradient(180deg, #90dff1 0%, #2c7faa 45%, #003053 100%);
}

.spot-thumb-1 {
  background: linear-gradient(180deg, #0e4c76 0%, #264c74 55%, #101b2f 100%);
}

.spot-thumb-2 {
  background: linear-gradient(180deg, #e9b07a 0%, #648fb4 42%, #003053 100%);
}

.spot-main {
  flex: 1;
}

.spot-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.spot-name {
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 800;
  color: #003053;
}

.risk-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
}

.risk-pill.low {
  background: rgba(122, 213, 221, 0.18);
  color: #006970;
}

.risk-pill.medium {
  background: rgba(100, 0, 9, 0.08);
  color: #93000a;
}

.risk-pill.high {
  background: rgba(186, 26, 26, 0.1);
  color: #ba1a1a;
}

.spot-meta {
  margin-top: 8rpx;
  color: #727780;
  font-size: 20rpx;
  font-weight: 600;
}

.spot-best {
  margin-top: 14rpx;
  color: #003053;
  font-size: 20rpx;
  font-weight: 800;
}
