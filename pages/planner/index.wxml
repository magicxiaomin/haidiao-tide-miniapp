<view class="container" wx:if="{{planner}}">
  <view class="topbar">
    <view class="topbar-left">
      <view class="topbar-dot"></view>
      <view class="topbar-title">Current Location</view>
    </view>
    <view class="topbar-action">Go</view>
  </view>

  <view class="plan-hero">
    <view class="plan-kicker">EXPEDITION PLANNING</view>
    <view class="plan-title">Master the Tides.</view>
    <view class="plan-copy">{{planner.weeklySummary.body}}</view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">Future Windows</view>
        <view class="section-subtitle">未来 7 天更适合出钓的窗口</view>
      </view>
    </view>
    <scroll-view scroll-x class="future-scroll" enhanced="true" show-scrollbar="false">
      <view class="future-row">
        <block wx:for="{{planner.windows}}" wx:key="day">
          <view class="future-card {{index === 0 ? 'focus' : ''}}">
            <view class="future-day">{{item.day}}</view>
            <view class="future-time">{{item.time}}</view>
            <view class="future-bar">
              <view class="future-bar-fill" style="width: {{item.score}}%;"></view>
            </view>
            <view class="future-score">Score {{item.score}}</view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-title">Location Comparison</view>
    <view class="compare-table">
      <view class="compare-head">
        <view>Destination</view>
        <view>Score</view>
        <view>Risk</view>
      </view>
      <block wx:for="{{planner.compare}}" wx:key="id">
        <view class="compare-line">
          <view class="compare-destination">
            <view class="compare-thumb compare-thumb-{{index}}"></view>
            <view>
              <view class="compare-name">{{item.name}}</view>
              <view class="compare-meta">{{item.bestWindow}}</view>
            </view>
          </view>
          <view class="compare-number">{{item.score}}</view>
          <view class="compare-risk {{item.riskLevel}}">{{item.riskText}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-title">Preparation List</view>
    <view class="prep-stack">
      <block wx:for="{{planner.checklist}}" wx:key="*this">
        <view class="prep-item">
          <view class="prep-icon">{{index === 0 ? 'R' : index === 1 ? 'B' : index === 2 ? 'T' : '!'}}</view>
          <view class="prep-copy">{{item}}</view>
        </view>
      </block>
    </view>
    <view class="safety-note">SAFETY NOTE</view>
    <view class="safety-card">High swell advisory for Sunday. Ensure all emergency gear and navigation alerts are verified before departure.</view>
  </view>
</view>
