.planner-hero {
  padding: 30rpx;
  background: linear-gradient(160deg, #10253b 0%, #17667f 100%);
  color: #ffffff;
}

.planner-title {
  font-size: 40rpx;
  font-weight: 700;
}

.planner-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.weekly-summary {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
}

.weekly-title {
  font-size: 28rpx;
  font-weight: 700;
}

.weekly-body {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.78);
}

.window-row {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.window-day {
  font-size: 30rpx;
  font-weight: 700;
}

.window-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
  line-height: 1.5;
}

.window-side {
  text-align: right;
}

.window-time {
  font-size: 28rpx;
  font-weight: 700;
}

.window-score {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
}

.compare-card,
.check-item {
  margin-top: 18rpx;
  padding: 26rpx;
}

.compare-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.compare-name {
  font-size: 28rpx;
  font-weight: 700;
}

.compare-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6a7b90;
}

.strategy-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #607087;
}

.compare-score {
  font-size: 36rpx;
  font-weight: 800;
  color: #0d5c75;
}

.check-item {
  font-size: 26rpx;
  line-height: 1.6;
  color: #122336;
}
