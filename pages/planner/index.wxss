.plan-hero {
  margin-top: 8rpx;
  padding: 40rpx 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #003053 0%, #004777 100%);
  color: #ffffff;
}

.plan-kicker {
  color: #84b6ec;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.plan-title {
  margin-top: 12rpx;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 64rpx;
  line-height: 1.05;
  font-weight: 800;
}

.plan-copy {
  margin-top: 18rpx;
  max-width: 420rpx;
  color: #d0e4ff;
  font-size: 24rpx;
  line-height: 1.7;
}

.future-scroll {
  margin: 0 -24rpx;
  padding: 0 24rpx 8rpx;
  white-space: nowrap;
}

.future-row {
  display: inline-flex;
  gap: 18rpx;
}

.future-card {
  min-width: 180rpx;
  padding: 28rpx 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(25, 28, 30, 0.04);
  text-align: center;
}

.future-card.focus {
  background: #003053;
  color: #ffffff;
  transform: scale(1.03);
}

.future-day {
  font-size: 18rpx;
  font-weight: 800;
  color: #727780;
  letter-spacing: 1.5rpx;
}

.future-card.focus .future-day,
.future-card.focus .future-score {
  color: #84b6ec;
}

.future-time {
  margin-top: 10rpx;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 800;
  color: #003053;
}

.future-card.focus .future-time {
  color: #ffffff;
}

.future-bar {
  margin: 18rpx auto 0;
  width: 88rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #eceef0;
  overflow: hidden;
}

.future-bar-fill {
  height: 100%;
  background: #006970;
  border-radius: 999rpx;
}

.future-card.focus .future-bar {
  background: rgba(255, 255, 255, 0.18);
}

.future-card.focus .future-bar-fill {
  background: #96f1fa;
}

.future-score {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #006970;
}

.compare-table {
  overflow: hidden;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
}

.compare-head,
.compare-line {
  display: grid;
  grid-template-columns: 1.8fr 0.6fr 0.8fr;
  gap: 16rpx;
  align-items: center;
  padding: 24rpx;
}

.compare-head {
  background: #f2f4f6;
  color: #727780;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.compare-destination {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.compare-thumb {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #9ccaff 0%, #2c6193 55%, #003053 100%);
}

.compare-thumb-1 {
  background: linear-gradient(180deg, #0e4c76 0%, #3c6d91 55%, #101b2f 100%);
}

.compare-thumb-2 {
  background: linear-gradient(180deg, #e9b07a 0%, #648fb4 45%, #003053 100%);
}

.compare-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #003053;
}

.compare-meta {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #727780;
}

.compare-number {
  text-align: center;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 800;
  color: #003053;
}

.compare-risk {
  justify-self: end;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.compare-risk.low {
  background: rgba(122, 213, 221, 0.18);
  color: #006970;
}

.compare-risk.medium {
  background: rgba(100, 0, 9, 0.08);
  color: #93000a;
}

.compare-risk.high {
  background: rgba(186, 26, 26, 0.1);
  color: #ba1a1a;
}

.prep-stack {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.prep-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
}

.prep-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #96f1fa;
  color: #006970;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.prep-copy {
  color: #003053;
  font-size: 24rpx;
  font-weight: 700;
}

.safety-note {
  margin-top: 28rpx;
  color: #93000a;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.safety-card {
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff1f0;
  color: #6f2f2f;
  font-size: 22rpx;
  line-height: 1.7;
}
