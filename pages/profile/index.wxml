<view class="container">
  <view class="topbar">
    <view class="topbar-left">
      <view class="topbar-dot"></view>
      <view class="topbar-title">Current Location</view>
    </view>
    <view class="topbar-action">Go</view>
  </view>

  <view class="profile-hero">
    <view class="avatar-ring">
      <view class="avatar-core"></view>
      <view class="pro-badge">PRO</view>
    </view>
    <view class="profile-name">{{profile.name}}</view>
    <view class="member-chip">{{profile.badge}}</view>
    <view class="profile-summary">{{profile.summary}}</view>
    <view class="profile-benefit-tag">BENEFITS</view>
    <view class="profile-cta">{{profile.cta}}</view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">My Collections</view>
      <view class="section-subtitle">View all</view>
    </view>
    <scroll-view scroll-x class="collection-scroll" enhanced="true" show-scrollbar="false">
      <view class="collection-row">
        <block wx:for="{{favorites}}" wx:key="id">
          <view class="collection-card">
            <view class="collection-image {{item.imageClass}}"></view>
            <view class="collection-name">{{item.name}}</view>
            <view class="collection-meta">saved spots</view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-title">Member Benefits</view>
    <view class="benefit-grid">
      <block wx:for="{{memberBenefits}}" wx:key="*this">
        <view class="benefit-card">
          <view class="benefit-icon">{{index === 0 ? 'S' : index === 1 ? 'I' : index === 2 ? 'C' : 'M'}}</view>
          <view class="benefit-name">{{item}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="partner-card">
      <view class="section-title">Business Partnership</view>
      <view class="partner-copy">Elevate your marina or maritime fleet with our enterprise integration solutions. Access real-time logistics and safety protocols for professional teams.</view>
      <view class="partner-button">Request Fleet Access</view>
      <view class="partner-image"></view>
    </view>
  </view>
</view>
