.profile-hero {
  padding: 30rpx;
  background: linear-gradient(160deg, #14324a 0%, #0d5c75 70%, #2a9db1 100%);
  color: #ffffff;
}

.profile-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.profile-subtitle {
  margin: 14rpx 0 28rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.78);
}

.favorite-card,
.benefit-item,
.business-card {
  margin-top: 18rpx;
  padding: 26rpx;
}

.favorite-name {
  font-size: 28rpx;
  font-weight: 700;
}

.favorite-window {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6a7b90;
}

.favorite-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #21384f;
}

.benefit-item {
  font-size: 26rpx;
  line-height: 1.6;
}
