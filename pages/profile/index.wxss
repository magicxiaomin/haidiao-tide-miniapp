.profile-hero {
  margin-top: 8rpx;
  padding: 34rpx 28rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #003053 0%, #004777 100%);
  color: #ffffff;
  text-align: center;
}

.avatar-ring {
  position: relative;
  width: 124rpx;
  height: 124rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(180deg, #d0e4ff 0%, #96f1fa 100%);
  padding: 6rpx;
}

.avatar-core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(180deg, #f1d4c2 0%, #97d3d7 45%, #0f3f5c 100%);
}

.pro-badge {
  position: absolute;
  right: -6rpx;
  bottom: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #96f1fa;
  color: #004f54;
  font-size: 16rpx;
  font-weight: 800;
}

.profile-name {
  margin-top: 20rpx;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 46rpx;
  font-weight: 800;
}

.member-chip {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffda67;
  color: #6f5500;
  font-size: 18rpx;
  font-weight: 800;
}

.profile-summary {
  margin: 18rpx auto 0;
  max-width: 520rpx;
  color: #d0e4ff;
  font-size: 22rpx;
  line-height: 1.7;
}

.profile-benefit-tag {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 1.8rpx;
}

.profile-cta {
  margin-top: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.collection-scroll {
  margin: 0 -24rpx;
  padding: 0 24rpx 8rpx;
  white-space: nowrap;
}

.collection-row {
  display: inline-flex;
  gap: 18rpx;
}

.collection-card {
  width: 240rpx;
  padding: 16rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
}

.collection-image {
  height: 120rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #95dff0 0%, #2c7faa 52%, #003053 100%);
}

.fav-image-1 {
  background: linear-gradient(180deg, #efc38b 0%, #9ccaff 42%, #003053 100%);
}

.collection-name {
  margin-top: 14rpx;
  color: #003053;
  font-size: 24rpx;
  font-weight: 800;
}

.collection-meta {
  margin-top: 6rpx;
  color: #727780;
  font-size: 18rpx;
}

.benefit-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.benefit-card {
  padding: 28rpx 18rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
  text-align: center;
}

.benefit-icon {
  width: 68rpx;
  height: 68rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  background: rgba(150, 241, 250, 0.3);
  color: #006970;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.benefit-name {
  margin-top: 14rpx;
  color: #003053;
  font-size: 20rpx;
  line-height: 1.5;
  font-weight: 700;
}

.partner-card {
  padding: 30rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
}

.partner-copy {
  margin-top: 18rpx;
  color: #42474f;
  font-size: 22rpx;
  line-height: 1.75;
}

.partner-button {
  margin-top: 22rpx;
  display: inline-flex;
  padding: 18rpx 26rpx;
  border-radius: 22rpx;
  background: #003053;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.partner-image {
  margin-top: 24rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #003053 0%, #2c6193 40%, #d0e4ff 100%);
}
