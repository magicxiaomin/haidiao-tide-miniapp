<view class="container" wx:if="{{spot}}">
  <view class="topbar">
    <view class="topbar-left">
      <view class="topbar-dot"></view>
      <view class="topbar-title">Current Location</view>
    </view>
    <view class="topbar-action">Go</view>
  </view>

  <view class="detail-hero">
    <view class="detail-overlay">
      <view class="detail-kicker">OCEANIC DETAIL</view>
      <view class="detail-name">{{spot.name}}</view>
      <view class="detail-chips">
        <view class="detail-window">
          <view class="detail-window-label">BEST WINDOW</view>
          <view class="detail-window-value">{{spot.bestWindow}}</view>
        </view>
        <view class="detail-risk">{{spot.riskText}}</view>
      </view>
    </view>
  </view>

  <view class="score-panel">
    <view class="score-arc">
      <view class="score-arc-ring"></view>
      <view class="score-core">
        <view class="score-panel-value">{{spot.score}}</view>
        <view class="score-panel-label">{{spot.scoreText}}</view>
      </view>
    </view>
    <view class="score-note">{{spot.description}}</view>
  </view>

  <scroll-view scroll-x class="spot-tabs" enhanced="true" show-scrollbar="false">
    <view class="spot-tabs-row">
      <block wx:for="{{spots}}" wx:key="id">
        <view class="spot-tab {{currentSpotId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="switchSpot">
          {{item.name}}
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="section">
    <view class="section-title">Pro Suggestions</view>
    <view class="suggest-box">
      <view class="suggest-item">
        <view class="suggest-icon aqua">A</view>
        <view class="suggest-main">
          <view class="suggest-head">Recommended Style</view>
          <view class="suggest-copy">{{spot.suggestion.method}}</view>
        </view>
      </view>
      <view class="suggest-item">
        <view class="suggest-icon aqua">T</view>
        <view class="suggest-main">
          <view class="suggest-head">Target Species</view>
          <view class="suggest-copy">{{spot.suggestion.targetFish}}</view>
        </view>
      </view>
      <view class="suggest-item">
        <view class="suggest-icon alert">!</view>
        <view class="suggest-main">
          <view class="suggest-head">Precautions</view>
          <view class="suggest-copy">{{spot.suggestion.warning}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="condition-row">
      <block wx:for="{{spot.conditions}}" wx:key="label">
        <view class="condition-tile">
          <view class="condition-symbol">{{index === 0 ? '≈' : index === 1 ? '≋' : index === 2 ? '°' : '☾'}}</view>
          <view class="condition-label">{{item.label}}</view>
          <view class="condition-value">{{item.value}}</view>
        </view>
      </block>
    </view>
    <view class="section-subtitle" wx:if="{{spot.liveMeta}}">{{spot.liveMeta}}</view>
  </view>

  <view class="section">
    <view class="section-title">Tide Timeline</view>
    <view class="timeline-card">
      <block wx:for="{{spot.timeline}}" wx:key="time">
        <view class="timeline-line">
          <view class="timeline-marker {{index === 1 ? 'active' : ''}}"></view>
          <view class="timeline-body">
            <view class="timeline-type">{{item.type}}</view>
            <view class="timeline-meta">{{item.note}}</view>
          </view>
          <view class="timeline-side">
            <view class="timeline-clock">{{item.time}}</view>
            <view class="timeline-height">{{item.height}}</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-title">Nearby Services</view>
    <view class="service-stack">
      <block wx:for="{{spot.services}}" wx:key="id">
        <view class="service-line">
          <view class="service-left">
            <view class="service-title">{{item.title}}</view>
            <view class="service-subtitle">{{item.subtitle}}</view>
          </view>
          <view class="button-secondary">{{item.cta}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
