.detail-hero {
  position: relative;
  margin-top: 8rpx;
  height: 420rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background:
    linear-gradient(180deg, rgba(0, 48, 83, 0.12) 0%, rgba(0, 48, 83, 0.62) 100%),
    linear-gradient(135deg, #1d6d8f 0%, #003053 68%);
}

.detail-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 34rpx;
}

.detail-kicker {
  color: #84b6ec;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.detail-name {
  margin-top: 10rpx;
  color: #ffffff;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 54rpx;
  line-height: 1.08;
  font-weight: 800;
}

.detail-chips {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-window {
  width: 220rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(20rpx);
}

.detail-window-label {
  color: rgba(255, 255, 255, 0.74);
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 1.8rpx;
}

.detail-window-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-risk {
  align-self: flex-start;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #8e0012;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.score-panel {
  margin-top: 22rpx;
  padding: 34rpx 28rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
  text-align: center;
}

.score-arc {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  margin: 0 auto;
}

.score-arc-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 12rpx solid #eceef0;
  border-top-color: #006970;
  border-right-color: #006970;
  transform: rotate(28deg);
}

.score-core {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-panel-value {
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1;
  color: #003053;
}

.score-panel-label {
  margin-top: 10rpx;
  color: #006970;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.score-note {
  margin-top: 18rpx;
  color: #727780;
  font-size: 24rpx;
  line-height: 1.6;
}

.spot-tabs {
  margin: 24rpx -24rpx 0;
  padding: 0 24rpx 8rpx;
  white-space: nowrap;
}

.spot-tabs-row {
  display: inline-flex;
  gap: 16rpx;
}

.spot-tab {
  padding: 18rpx 30rpx;
  border-radius: 22rpx;
  background: #eceef0;
  color: #42474f;
  font-size: 24rpx;
  font-weight: 700;
}

.spot-tab.active {
  background: #003053;
  color: #ffffff;
}

.suggest-box {
  padding: 28rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
}

.suggest-item {
  display: flex;
  gap: 18rpx;
}

.suggest-item + .suggest-item {
  margin-top: 24rpx;
}

.suggest-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.suggest-icon.aqua {
  background: #96f1fa;
  color: #006f77;
}

.suggest-icon.alert {
  background: #ffdad6;
  color: #93000a;
}

.suggest-main {
  flex: 1;
}

.suggest-head {
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 800;
  color: #003053;
}

.suggest-copy {
  margin-top: 8rpx;
  color: #42474f;
  font-size: 24rpx;
  line-height: 1.6;
}

.condition-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.condition-tile {
  padding: 24rpx;
  background: #f2f4f6;
  border-radius: 28rpx;
}

.condition-symbol {
  color: #006970;
  font-size: 28rpx;
}

.condition-label {
  margin-top: 18rpx;
  color: #727780;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.condition-value {
  margin-top: 10rpx;
  color: #003053;
  font-family: "Arial", "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.timeline-card {
  padding: 24rpx 26rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
}

.timeline-line {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 18rpx 0;
}

.timeline-marker {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d8dadc;
  flex-shrink: 0;
}

.timeline-marker.active {
  background: #006970;
}

.timeline-body {
  flex: 1;
}

.timeline-type {
  font-size: 26rpx;
  font-weight: 800;
  color: #003053;
}

.timeline-meta {
  margin-top: 6rpx;
  color: #727780;
  font-size: 20rpx;
}

.timeline-side {
  text-align: right;
}

.timeline-clock {
  color: #003053;
  font-size: 24rpx;
  font-weight: 800;
}

.timeline-height {
  margin-top: 6rpx;
  color: #727780;
  font-size: 20rpx;
}

.service-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-line {
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 30, 0.04);
}

.service-left {
  flex: 1;
}
