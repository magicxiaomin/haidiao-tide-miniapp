.spot-hero {
  padding: 32rpx;
  background: linear-gradient(180deg, #0c2137 0%, #123f59 100%);
  color: #ffffff;
}

.spot-hero-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.spot-city {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.spot-title {
  margin-top: 12rpx;
  width: 430rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.spot-badge {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
}

.spot-score-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.chip.light {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

.chip.light.outline {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.audience-row {
  margin-top: 16rpx;
}

.spot-description {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.84);
}

.spot-highlight {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.spot-highlight view {
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
}

.label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.spot-tabs {
  margin-top: 18rpx;
  white-space: nowrap;
}

.spot-tab {
  display: inline-block;
  margin-right: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(13, 92, 117, 0.08);
  color: #0d5c75;
  font-size: 24rpx;
}

.spot-tab.active {
  background: linear-gradient(135deg, #0d5c75, #1b8399);
  color: #ffffff;
}

.suggestion-panel {
  margin-top: 18rpx;
  padding: 28rpx;
}

.reason-panel,
.gear-panel {
  margin-top: 18rpx;
  padding: 28rpx;
}

.reason-item,
.gear-item {
  font-size: 25rpx;
  line-height: 1.7;
  color: #183149;
}

.reason-item + .reason-item,
.gear-item + .gear-item {
  margin-top: 14rpx;
}

.suggest-line + .suggest-line {
  margin-top: 20rpx;
}

.suggest-label {
  display: block;
  font-size: 22rpx;
  color: #6a7b90;
}

.suggest-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #102033;
}

.suggest-value.warn {
  color: #b4542d;
}

.spot-timeline-item {
  margin-top: 18rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.timeline-time {
  font-size: 30rpx;
  font-weight: 700;
}

.timeline-type {
  margin-top: 8rpx;
  color: #6a7b90;
  font-size: 22rpx;
}

.timeline-right {
  text-align: right;
}

.timeline-height {
  font-size: 28rpx;
  font-weight: 700;
}

.timeline-note {
  margin-top: 8rpx;
  color: #6a7b90;
  font-size: 22rpx;
}

.condition-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.condition-card {
  padding: 24rpx;
}

.condition-label {
  font-size: 22rpx;
  color: #6a7b90;
}

.condition-value {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.service-row {
  margin-top: 18rpx;
  padding: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.service-title {
  font-size: 28rpx;
  font-weight: 700;
}

.service-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6a7b90;
  line-height: 1.5;
}
